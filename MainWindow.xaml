<Window x:Class="IosBackupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:IosBackupApp.Converters"
        xmlns:models="clr-namespace:IosBackupApp.Models"
        mc:Ignorable="d"
        Title="iPhone Media Backup Utility (WPD/MTP)" 
        Height="880" Width="1240"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Value Converters -->
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <conv:SpeedConverter x:Key="SpeedConverter" />
        <conv:TimeRemainingConverter x:Key="TimeRemainingConverter" />
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:BooleanToVisibilityInverseConverter x:Key="BoolToVisInverseConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Modern Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
        <SolidColorBrush x:Key="CardBg" Color="#1E293B" />
        <SolidColorBrush x:Key="CardBorder" Color="#334155" />
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentIndigo" Color="#6366F1" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />

        <!-- Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Progress Bar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" CornerRadius="4" />
                                <Border x:Name="PART_Indicator" 
                                        Background="{TemplateBinding Foreground}" 
                                        CornerRadius="4" 
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Hierarchical Data Template for TreeView -->
        <HierarchicalDataTemplate DataType="{x:Type models:FileDiffNodeViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="2,3" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Checkbox with cascading support -->
                <CheckBox Grid.Column="0" 
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Folder / File Icon Indicator -->
                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="4" Margin="0,0,8,0"
                        Background="#334155" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconKind, Converter={x:Null}}" 
                               FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBlue}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="📄" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter Property="Text" Value="📁" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Name & Child Count -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#F8FAFC" FontSize="13" />
                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} files)'}" 
                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- File Size -->
                <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" 
                           Foreground="{StaticResource TextSecondary}" 
                           FontSize="12" Margin="16,0,16,0" VerticalAlignment="Center" />

                <!-- Status Badge -->
                <Border Grid.Column="4" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                        Background="#0F172A" BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" BorderThickness="1">
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" 
                               FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header & Device Status Banner -->
            <RowDefinition Height="Auto" />
            <!-- Storage Dashboard Metrics -->
            <RowDefinition Height="Auto" />
            <!-- Configuration & Controls Panel -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area (TreeView + Transfer Logs) -->
            <RowDefinition Height="*" />
            <!-- Transfer & Estimation Dashboard -->
            <RowDefinition Height="Auto" />
            <!-- Status & HEIC Notice Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="iPhone Media Backup Utility" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Wired High-Performance WPD / MTP Backup with Diff Engine" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Device Connection Pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="20" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource AccentGreen}" />
                        <TextBlock Text="{Binding SelectedDevice.DisplayName, FallbackValue='No Device'}" 
                                   Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Dual Storage Metrics Dashboard -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- iPhone Storage Card -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📱 iPhone Storage Capacity" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding IPhoneStorage.UsedPercentage, StringFormat='{}{0:F1}% Used'}" 
                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" FontSize="13" />
                    </Grid>

                    <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding IPhoneStorage.UsedPercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentBlue}" Height="12" Margin="0,0,0,8" />

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding IPhoneStorage.UsedFormatted, StringFormat='Used: {0}'}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding IPhoneStorage.FreeFormatted, StringFormat='Free: {0}'}" 
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding IPhoneStorage.TotalFormatted, StringFormat='Total: {0}'}" 
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Laptop Destination Storage Card -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="💻 Laptop Destination Drive" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding LaptopStorage.UsedPercentage, StringFormat='{}{0:F1}% Used'}" 
                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="13" />
                    </Grid>

                    <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding LaptopStorage.UsedPercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentGreen}" Height="12" Margin="0,0,0,8" />

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding LaptopStorage.UsedFormatted, StringFormat='Used: {0}'}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding LaptopStorage.FreeFormatted, StringFormat='Free: {0}'}" 
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding LaptopStorage.TotalFormatted, StringFormat='Total: {0}'}" 
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Configuration & Control Bar -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Device Selector -->
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <!-- Destination Picker -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <!-- Concurrency Slider -->
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <!-- Scan Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Source Device Selector -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Source iPhone Device" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}" 
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DisplayName"
                                  Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Height="34" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}" 
                                Style="{StaticResource ModernButton}" Content="🔄" 
                                ToolTip="Refresh connected USB devices" Margin="6,0,0,0" Width="36" Height="34" Padding="0" />
                    </Grid>
                </StackPanel>

                <!-- Destination Folder Picker -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Backup Destination Folder" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" 
                                 Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" />
                        <Button Grid.Column="1" Command="{Binding BrowseDestinationCommand}" 
                                Style="{StaticResource ModernButton}" Content="Browse..." Margin="6,0,0,0" Height="34" />
                        <Button Grid.Column="2" Command="{Binding OpenDestinationFolderCommand}" 
                                Style="{StaticResource ModernButton}" Content="📂 Open" Margin="6,0,0,0" Height="34" />
                    </Grid>
                </StackPanel>

                <!-- Concurrency Slider -->
                <StackPanel Grid.Column="4">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Parallel Transfers" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding Concurrency, StringFormat='{}{0} Stream(s)'}" 
                                   HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                    </Grid>
                    <Slider Minimum="1" Maximum="8" Value="{Binding Concurrency}" 
                            TickFrequency="1" IsSnapToTickEnabled="True" 
                            ToolTip="Sequential (1 stream) is recommended over Lightning/USB 2.0 to avoid MTP pipe bottlenecks. USB 3.0/USB-C supports 2-4 streams."
                            Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="1 stream recommended for USB 2.0" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Action Button: Scan -->
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                    <Button Command="{Binding ScanCommand}" 
                            Style="{StaticResource PrimaryButton}" 
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                            Height="34" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding IsScanning, Converter={x:Null}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Scan iPhone Media" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text" Value="Scanning..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Main Body: Checkbox TreeView & Activity Logs -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- TreeView (70%) -->
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="16" />
                <!-- Activity Log & Metadata (3*) -->
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Checkbox TreeView Card -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- TreeView Filter Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- TreeView Control -->
                        <RowDefinition Height="*" />
                        <!-- TreeView Footer Stats -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter & Selection Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Filter -->
                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" 
                                     Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" />
                            <TextBlock Text="Search files (.heic, .mov)..." Foreground="{StaticResource TextSecondary}" 
                                       IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Quick Selection Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding SelectAllPendingCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Select Pending" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding SelectAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Select All" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding DeselectAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Deselect All" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding ExpandAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Expand" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding CollapseAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Collapse" Padding="8,4" FontSize="11" />
                        </StackPanel>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Content="All" IsChecked="{Binding FilterMode, Converter={x:Null}}" 
                                         Foreground="#F8FAFC" Margin="0,0,12,0" VerticalAlignment="Center">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterMode}" Value="All">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            <RadioButton Content="Pending Only" Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterMode}" Value="PendingOnly">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            <RadioButton Content="Backed Up" Foreground="#10B981" VerticalAlignment="Center">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterMode}" Value="BackedUpOnly">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <!-- Virtualized TreeView -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <!-- Empty State Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TreeItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6" />
                                <TextBlock Text="No media loaded yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F8FAFC" />
                                <TextBlock Text="Click 'Scan iPhone Media' above to discover Photos &amp; Videos." 
                                           FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Virtualized TreeView -->
                            <TreeView ItemsSource="{Binding TreeItems}" 
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="#F8FAFC"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#F8FAFC" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E293B" />
                                                <Setter Property="Foreground" Value="#38BDF8" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- TreeView Footer Stats -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Files: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalFilesCount}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" Margin="0,0,16,0" />

                            <TextBlock Text="Pending Backup: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding PendingFilesCount}" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" FontSize="12" Margin="0,0,16,0" />

                            <TextBlock Text="Already Synced: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding BackedUpFilesCount}" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="12" Margin="0,0,16,0" />
                        </StackPanel>

                        <!-- Selected files counter badge -->
                        <Border HorizontalAlignment="Right" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Selected for Backup: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedFilesCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                                <TextBlock Text=" files (" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedSizeFormatted}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                                <TextBlock Text=")" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Activity Logs & JSON Metadata Card -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📜 Activity Log" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" />
                        <Button HorizontalAlignment="Right" Command="{Binding OpenStateJsonFolderCommand}" 
                                Style="{StaticResource ModernButton}" Content="View JSONs" Padding="8,2" FontSize="11" />
                    </Grid>

                    <!-- Activity Log List -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <ListBox ItemsSource="{Binding ActivityLogs}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Foreground="{StaticResource TextSecondary}" FontSize="11" FontFamily="Consolas, monospace">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- Metadata JSON Status Info -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="JSON State Files (Unified Schema):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="• iphone_state.json" FontSize="11" Foreground="#38BDF8" Margin="4,2,0,0" />
                        <TextBlock Text="• laptop_state.json" FontSize="11" Foreground="#10B981" Margin="4,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Transfer Engine & Estimations Dashboard -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Transfer Controls & Rate/ETA Metrics -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding StartBackupCommand}" 
                                Style="{StaticResource SuccessButton}" 
                                IsEnabled="{Binding IsTransferring, Converter={StaticResource InverseBooleanConverter}}"
                                Padding="20,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶ Start Backup" FontSize="13" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PauseResumeCommand}" 
                                Style="{StaticResource ModernButton}" 
                                IsEnabled="{Binding IsTransferring}"
                                Padding="14,8" Margin="0,0,10,0">
                            <TextBlock Text="{Binding IsPaused, Converter={x:Null}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏸ Pause" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="▶ Resume" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Button Command="{Binding CancelBackupCommand}" 
                                Style="{StaticResource DangerButton}" 
                                IsEnabled="{Binding IsTransferring}"
                                Content="⏹ Cancel" Padding="14,8" />
                    </StackPanel>

                    <!-- Real-Time Transfer Metrics (Moving Average Speed & ETA) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Transfer Speed -->
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Transfer Speed: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding ProgressInfo.BytesPerSecond, Converter={StaticResource SpeedConverter}}" 
                                           FontWeight="Bold" Foreground="{StaticResource AccentBlue}" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <!-- Estimated Time Remaining -->
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estimated Time: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding ProgressInfo.EstimatedTimeRemaining, Converter={StaticResource TimeRemainingConverter}}" 
                                           FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Dual Progress Bars: Overall & Current File -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Overall Progress Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="{Binding ProgressInfo.StatusMessage, FallbackValue='Ready to transfer'}" 
                                   Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ProgressInfo.CompletedFiles, StringFormat='{}{0} / '}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding ProgressInfo.TotalFiles, StringFormat='{}{0} files ('}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding ProgressInfo.OverallPercentage, StringFormat='{}{0:F1}%)'}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Overall Progress Bar -->
                    <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding ProgressInfo.OverallPercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentBlue}" Height="10" Margin="0,0,0,10" />

                    <!-- Current File Progress Header -->
                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <TextBlock Text="{Binding ProgressInfo.CurrentFileName, StringFormat='Current File: {0}', FallbackValue=''}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" />
                        <TextBlock Text="{Binding ProgressInfo.CurrentFilePercentage, StringFormat='{}{0:F0}%'}" 
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                    </Grid>

                    <!-- Current File Progress Bar -->
                    <ProgressBar Grid.Row="3" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding ProgressInfo.CurrentFilePercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentIndigo}" Height="6" />
                </Grid>
            </Grid>
        </Border>

        <!-- 6. Bottom Notice Bar -->
        <Border Grid.Row="5" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="ℹ️ High-Efficiency Formats: Raw HEIC &amp; MOV files and timestamps are preserved identically. Windows requires HEVC &amp; HEIF Extensions from Microsoft Store for local thumbnail previews." 
                           Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
