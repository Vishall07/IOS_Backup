<Window x:Class="IosBackupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:IosBackupApp.Converters"
        xmlns:models="clr-namespace:IosBackupApp.Models"
        mc:Ignorable="d"
        Title="iPhone Media Backup Utility (WPD/MTP)" 
        Height="880" Width="1240"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Value Converters -->
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <conv:SpeedConverter x:Key="SpeedConverter" />
        <conv:TimeRemainingConverter x:Key="TimeRemainingConverter" />
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:BooleanToVisibilityInverseConverter x:Key="BoolToVisInverseConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <conv:NullToVisibilityInverseConverter x:Key="NullToVisInverseConverter" />

        <!-- Modern Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
        <SolidColorBrush x:Key="CardBg" Color="#1E293B" />
        <SolidColorBrush x:Key="CardBorder" Color="#334155" />
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentIndigo" Color="#6366F1" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />

        <!-- Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Progress Bar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" CornerRadius="4" />
                                <Border x:Name="PART_Indicator" 
                                        Background="{TemplateBinding Foreground}" 
                                        CornerRadius="4" 
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Modern ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="9,6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ModernComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" 
                    SnapsToDevicePixels="true">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <!-- Chevron Down Path -->
                    <Path x:Name="arrow" 
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0" 
                          Stroke="#94A3B8" 
                          StrokeThickness="2" 
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="templateRoot" Property="Background" Value="#1E293B" />
                    <Setter TargetName="arrow" Property="Stroke" Value="#38BDF8" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="templateRoot" Property="Background" Value="#1E293B" />
                    <Setter TargetName="arrow" Property="Stroke" Value="#38BDF8" />
                    <Setter TargetName="arrow" Property="Data" Value="M 0 4 L 4 0 L 8 4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.5" />
                    <Setter TargetName="arrow" Property="Stroke" Value="#64748B" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBoxItem Style -->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="2,1"
                                CornerRadius="4" 
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="itemBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="itemBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0,28,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxDropDownHeight" Value="300" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="true" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Focusable="False" 
                                          ClickMode="Press"
                                          Template="{StaticResource ModernComboBoxToggleButtonTemplate}" />

                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              IsHitTestVisible="false" 
                                              Margin="{TemplateBinding Padding}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="true" 
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   VerticalOffset="2"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border x:Name="dropDownBorder" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        Background="#1E293B" 
                                        BorderBrush="#334155" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="2">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Focusable="false" CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Contained" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="MinHeight" Value="40" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hierarchical Data Template for TreeView -->
        <HierarchicalDataTemplate DataType="{x:Type models:FileDiffNodeViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="2,3" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Checkbox with cascading support -->
                <CheckBox Grid.Column="0" 
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Folder / File Icon Indicator -->
                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="4" Margin="0,0,8,0"
                        Background="#334155" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconKind, Converter={x:Null}}" 
                               FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBlue}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="📄" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter Property="Text" Value="📁" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Name & Child Count -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#F8FAFC" FontSize="13" />
                    <!-- Live Photo Badge if paired -->
                    <Border Background="#162032" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                            Visibility="{Binding HasLivePhotoBadge, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding LivePhotoBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                    </Border>
                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} files)'}" 
                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- File Size -->
                <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" 
                           Foreground="{StaticResource TextSecondary}" 
                           FontSize="12" Margin="16,0,16,0" VerticalAlignment="Center" />

                <!-- Status Badge -->
                <Border Grid.Column="4" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                        Background="#0F172A" BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" BorderThickness="1">
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" 
                               FontSize="11" FontWeight="SemiBold" />
                </Border>

                <!-- Quick Preview Action Button -->
                <Button Grid.Column="5" Content="👁️ Preview"
                        Command="{Binding DataContext.PreviewTreeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Padding="6,2" FontSize="11" Margin="8,0,0,0"
                        ToolTip="Preview this photo or video in the Lightbox viewer">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Main Application Layout -->
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header & Device Status Banner -->
            <RowDefinition Height="Auto" />
            <!-- Storage Dashboard Metrics -->
            <RowDefinition Height="Auto" />
            <!-- Configuration & Controls Panel -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area (TreeView + Transfer Logs) -->
            <RowDefinition Height="*" />
            <!-- Transfer & Estimation Dashboard -->
            <RowDefinition Height="Auto" />
            <!-- Status & HEIC Notice Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="iPhone Media Backup Utility" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Wired High-Performance WPD / MTP Backup with Diff Engine" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Device Connection Pill & Process Monitor Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="20" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource AccentGreen}" />
                        <TextBlock Text="{Binding SelectedDevice.DisplayName, FallbackValue='No Device'}" 
                                   Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Button Command="{Binding OpenProcessModalCommand}" Style="{StaticResource ModernButton}" 
                        ToolTip="Open real-time internal process monitor and diagnostic terminal"
                        Padding="12,6" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊 View Process Modal / Logs" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBlue}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Dual Storage Metrics Dashboard -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- iPhone Storage Card -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📱 iPhone Storage Capacity" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding IPhoneStorage.UsedPercentage, StringFormat='{}{0:F1}% Used'}" 
                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" FontSize="13" />
                    </Grid>

                    <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding IPhoneStorage.UsedPercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentBlue}" Height="12" Margin="0,0,0,8" />

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding IPhoneStorage.UsedFormatted, StringFormat='Used: {0}'}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding IPhoneStorage.FreeFormatted, StringFormat='Free: {0}'}" 
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding IPhoneStorage.TotalFormatted, StringFormat='Total: {0}'}" 
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Laptop Destination Storage Card -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="💻 Laptop Destination Drive" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding LaptopStorage.UsedPercentage, StringFormat='{}{0:F1}% Used'}" 
                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="13" />
                    </Grid>

                    <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding LaptopStorage.UsedPercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentGreen}" Height="12" Margin="0,0,0,8" />

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding LaptopStorage.UsedFormatted, StringFormat='Used: {0}'}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding LaptopStorage.FreeFormatted, StringFormat='Free: {0}'}" 
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding LaptopStorage.TotalFormatted, StringFormat='Total: {0}'}" 
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Configuration & Control Bar -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Device Selector -->
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <!-- Destination Picker -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <!-- Concurrency Slider -->
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <!-- Scan Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Source Device Selector -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Source iPhone Device" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}" 
                                  SelectedItem="{Binding SelectedDevice}"
                                  Style="{StaticResource ModernComboBox}"
                                  ToolTip="Select connected iPhone device or Demo Mode"
                                  Height="34" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DeviceInfoModel}">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}" 
                                Style="{StaticResource ModernButton}" Content="🔄" 
                                ToolTip="Rescan USB ports for connected iPhone devices" Margin="6,0,0,0" Width="36" Height="34" Padding="0" />
                    </Grid>
                </StackPanel>

                <!-- Destination Folder Picker -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Backup Destination Folder" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" 
                                 ToolTip="Local folder path on your computer where media files are saved"
                                 Height="34" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" />
                        <Button Grid.Column="1" Command="{Binding BrowseDestinationCommand}" 
                                Style="{StaticResource ModernButton}" Content="Browse..." 
                                ToolTip="Choose backup destination folder on your laptop or external drive"
                                Margin="6,0,0,0" Height="34" />
                        <Button Grid.Column="2" Command="{Binding OpenDestinationFolderCommand}" 
                                Style="{StaticResource ModernButton}" Content="📂 Open" 
                                ToolTip="Open destination folder in Windows File Explorer"
                                Margin="6,0,0,0" Height="34" />
                    </Grid>
                </StackPanel>

                <!-- Concurrency Slider -->
                <StackPanel Grid.Column="4">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Parallel Transfers" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding Concurrency, StringFormat='{}{0} Stream(s)'}" 
                                   HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                    </Grid>
                    <Slider Minimum="1" Maximum="8" Value="{Binding Concurrency}" 
                            TickFrequency="1" IsSnapToTickEnabled="True" 
                            ToolTip="Sequential (1 stream) is recommended over Lightning/USB 2.0 to avoid MTP pipe bottlenecks. USB 3.0/USB-C supports 2-4 streams."
                            Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="1 stream recommended for USB 2.0" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Action Button: Scan -->
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                    <Button Command="{Binding ScanCommand}" 
                            Style="{StaticResource PrimaryButton}" 
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                            ToolTip="Scan iPhone media library, inspect destination directory, and generate backup diff"
                            Height="34" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding IsScanning, Converter={x:Null}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Scan iPhone Media" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text" Value="Scanning..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Main Body: Checkbox TreeView & Activity Logs -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- TreeView (70%) -->
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="16" />
                <!-- Activity Log & Metadata (3*) -->
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Media View Card (Tree View vs Preview Gallery) -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: View Mode Switcher Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Content Host -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Segmented View Mode Switcher Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="📁 Backup Tree" 
                                             IsChecked="{Binding IsGalleryView, Converter={StaticResource InverseBooleanConverter}}"
                                             Command="{Binding SwitchViewModeCommand}" CommandParameter="Tree"
                                             ToolTip="View directory hierarchy, check unbacked files, and configure backup diff"
                                             Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"
                                             Padding="14,6" Margin="0,0,3,0">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#2563EB" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsChecked" Value="True" />
                                                                    <Condition Property="IsMouseOver" Value="True" />
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8" />
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>

                                <RadioButton Content="🖼️ Preview Gallery" 
                                             IsChecked="{Binding IsGalleryView}"
                                             Command="{Binding SwitchViewModeCommand}" CommandParameter="Gallery"
                                             ToolTip="Apple Photos style gallery: View HEIC images, Live Photos, and videos"
                                             Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"
                                             Padding="14,6">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#0284C7" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsChecked" Value="True" />
                                                                    <Condition Property="IsMouseOver" Value="True" />
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="bd" Property="Background" Value="#0369A1" />
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#162032" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✦ Apple Photos Engine (HEIC + Live Photos)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Content Host -->
                    <Grid Grid.Row="1">
                        <!-- VIEW 1: Checkbox TreeView (when IsGalleryView == False) -->
                        <Grid Visibility="{Binding IsGalleryView, Converter={StaticResource BoolToVisInverseConverter}}">
                            <Grid.RowDefinitions>
                                <!-- TreeView Filter Bar -->
                                <RowDefinition Height="Auto" />
                                <!-- TreeView Control -->
                                <RowDefinition Height="*" />
                                <!-- TreeView Footer Stats -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Filter & Selection Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Filter -->
                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" 
                                     ToolTip="Filter media files by filename or extension (e.g., .HEIC, .MOV, .JPG)"
                                     Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" />
                            <TextBlock Text="Search files (.heic, .mov)..." Foreground="{StaticResource TextSecondary}" 
                                       IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Quick Selection Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding FindDiffAndShowPendingCommand}" Style="{StaticResource ModernButton}" 
                                    Content="🔍 Show Unbacked Only" ToolTip="Calculate diff between iPhone and laptop JSON, and show strictly unbacked photos &amp; videos" 
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding SelectAllPendingCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Select Pending" ToolTip="Select all new or modified media items waiting for backup" 
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding SelectAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Select All" ToolTip="Check all media files across all folders" 
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding DeselectAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Deselect All" ToolTip="Uncheck all media items" 
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding ExpandAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Expand" ToolTip="Expand all folders in the media tree" 
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding CollapseAllCommand}" Style="{StaticResource ModernButton}" 
                                    Content="Collapse" ToolTip="Collapse all folders in the media tree" 
                                    Padding="8,4" FontSize="11" />
                        </StackPanel>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Live Photo Exclude Option -->
                            <CheckBox IsChecked="{Binding SkipLivePhotoVideos, Mode=TwoWay}"
                                      Content="Exclude Live Photo Clips (.MOV)" 
                                      FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"
                                      ToolTip="When checked, 3-second motion videos (.MOV) paired with Live Photos are excluded from backup, backing up strictly high-res photos (.HEIC/.JPG) and standalone videos."
                                      Margin="0,0,14,0" VerticalAlignment="Center" />

                            <RadioButton Content="All" IsChecked="{Binding FilterMode, Converter={x:Null}}" 
                                         ToolTip="Show all files in the tree view"
                                         Foreground="#F8FAFC" Margin="0,0,12,0" VerticalAlignment="Center">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterMode}" Value="All">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            <RadioButton Content="Pending Only" Foreground="#F59E0B" 
                                         ToolTip="Show only files not yet backed up or with size differences"
                                         Margin="0,0,12,0" VerticalAlignment="Center">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterMode}" Value="PendingOnly">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            <RadioButton Content="Backed Up" Foreground="#10B981" 
                                         ToolTip="Show only files that already exist identically in destination folder"
                                         VerticalAlignment="Center">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterMode}" Value="BackedUpOnly">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <!-- Virtualized TreeView -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <!-- Empty State Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TreeItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6" />
                                <TextBlock Text="No media loaded yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F8FAFC" />
                                <TextBlock Text="Click 'Scan iPhone Media' above to discover Photos &amp; Videos." 
                                           FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Virtualized TreeView -->
                            <TreeView ItemsSource="{Binding TreeItems}" 
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="#F8FAFC"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#F8FAFC" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E293B" />
                                                <Setter Property="Foreground" Value="#38BDF8" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- TreeView Footer Stats -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Files: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding TotalFilesCount}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" Margin="0,0,16,0" />

                            <TextBlock Text="Pending Backup: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding PendingFilesCount}" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" FontSize="12" Margin="0,0,16,0" />

                            <TextBlock Text="Already Synced: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding BackedUpFilesCount}" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="12" Margin="0,0,16,0" />
                        </StackPanel>

                        <!-- Selected files counter badge -->
                        <Border HorizontalAlignment="Right" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Selected for Backup: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedFilesCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                                <TextBlock Text=" files (" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding SelectedSizeFormatted}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                                <TextBlock Text=")" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 2: Apple Photos Preview Gallery (when IsGalleryView == True) -->
                <Grid Visibility="{Binding IsGalleryView, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <!-- Gallery Filter & Search Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Gallery Grid -->
                        <RowDefinition Height="*" />
                        <!-- Gallery Footer Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Gallery Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <!-- Search Box -->
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <!-- Filter Pills -->
                            <ColumnDefinition Width="*" />
                            <!-- Thumbnail Size Slider & Refresh -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding GallerySearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" 
                                     ToolTip="Filter gallery photos and videos by filename or folder"
                                     Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" />
                            <TextBlock Text="Search gallery (.heic, .mov)..." Foreground="{StaticResource TextSecondary}" 
                                       IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GallerySearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Category Pills (Apple Photos Style) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- All Media -->
                            <RadioButton Content="{Binding GalleryItems.Count, StringFormat='All ({0})'}" 
                                         IsChecked="{Binding GalleryFilter, Converter={x:Null}}" 
                                         ToolTip="Show all photos and videos"
                                         Foreground="#F8FAFC" Margin="0,0,8,0" VerticalAlignment="Center">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GalleryFilter}" Value="All">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <!-- Photos -->
                            <RadioButton Content="{Binding GalleryTotalPhotos, StringFormat='📷 Photos ({0})'}" 
                                         Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"
                                         ToolTip="Show HEIC and JPEG photos">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GalleryFilter}" Value="Photos">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <!-- Live Photos -->
                            <RadioButton Content="{Binding GalleryTotalLivePhotos, StringFormat='◉ Live Photos ({0})'}" 
                                         Foreground="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center"
                                         ToolTip="Show Apple Live Photos with interactive motion playback">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GalleryFilter}" Value="LivePhotos">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <!-- Videos -->
                            <RadioButton Content="{Binding GalleryTotalVideos, StringFormat='🎬 Videos ({0})'}" 
                                         Foreground="#A78BFA" Margin="0,0,8,0" VerticalAlignment="Center"
                                         ToolTip="Show standalone video recordings (.MOV, .MP4)">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="IsChecked" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GalleryFilter}" Value="Videos">
                                                <Setter Property="IsChecked" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>

                        <!-- Right: Size Slider & Refresh Button -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Size:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider Width="90" Minimum="110" Maximum="240" Value="{Binding GalleryCardSize}" 
                                    VerticalAlignment="Center" ToolTip="Adjust thumbnail grid size" Margin="0,0,12,0" />
                            <Button Command="{Binding RefreshGalleryCommand}" Style="{StaticResource ModernButton}" 
                                    Content="🔄 Refresh" ToolTip="Reload backed up media from destination folder" 
                                    Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <!-- 2. Grid Body -->
                    <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <!-- Loading Indicator -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsLoadingGallery, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Loading Media Gallery..." FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                <TextBlock Text="Scanning destination directory for HEIC photos and videos..." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FilteredGalleryItems.Count}" Value="0" />
                                                    <Condition Binding="{Binding IsLoadingGallery}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="🖼️" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.5" />
                                <TextBlock Text="No media items found in destination" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                <TextBlock Text="Back up media from your iPhone or click Refresh to discover files in your backup folder." 
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,12" />
                                <Button Command="{Binding RefreshGalleryCommand}" Style="{StaticResource PrimaryButton}" 
                                        Content="🔄 Scan Destination Folder" Padding="14,6" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Apple Photos Grid ListBox -->
                            <ListBox ItemsSource="{Binding FilteredGalleryItems}"
                                     SelectedItem="{Binding SelectedGalleryItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="4" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GalleryItemViewModel}">
                                        <Border Width="{Binding DataContext.GalleryCardSize, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Height="{Binding DataContext.GalleryCardSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                                                CornerRadius="8" ClipToBounds="True" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" 
                                                              Command="{Binding DataContext.OpenGalleryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <!-- Thumbnail Image (Decoded HEIC / Video / JPG) -->
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                                <!-- Loading / Fallback Placeholder -->
                                                <Border Background="#162032" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisInverseConverter}}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="🖼️" FontSize="24" HorizontalAlignment="Center" Opacity="0.4" />
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Top-Left Media Badge (LIVE / VIDEO / HEIC) -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" 
                                                        Background="#D90B1220" CornerRadius="4" Padding="5,2" BorderBrush="#475569" BorderThickness="1">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeBg}" />
                                                </Border>

                                                <!-- Hover Info Overlay -->
                                                <Border x:Name="HoverOverlay" Background="#E60B1220" VerticalAlignment="Bottom" Padding="8,6" Opacity="0">
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="10" Foreground="#94A3B8" />
                                                                <TextBlock Text=" • " FontSize="10" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding Folder}" FontSize="10" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 3. Gallery Footer Bar -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Viewing Destination: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding DestinationFolder}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            <TextBlock Text="{Binding FilteredGalleryItems.Count, StringFormat='  ({0} items shown)'}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding OpenDestinationFolderCommand}" Style="{StaticResource ModernButton}" 
                                    Content="📂 Open Folder in Explorer" Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>

            <!-- Activity Logs & JSON Metadata Card -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📜 Internal Process Log" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding OpenProcessModalCommand}" 
                                    Style="{StaticResource ModernButton}" Content="🔍 Modal" Padding="6,2" FontSize="10" Margin="0,0,4,0" 
                                    ToolTip="Open real-time internal process monitor and diagnostic terminal" />
                            <Button Command="{Binding CopyLogsCommand}" 
                                    Style="{StaticResource ModernButton}" Content="📋" Padding="5,2" FontSize="10" Margin="0,0,4,0" 
                                    ToolTip="Copy all internal process logs to clipboard" />
                            <Button Command="{Binding ClearLogsCommand}" 
                                    Style="{StaticResource ModernButton}" Content="🧹" Padding="5,2" FontSize="10" Margin="0,0,4,0" 
                                    ToolTip="Clear internal log display" />
                            <Button Command="{Binding OpenStateJsonFolderCommand}" 
                                    Style="{StaticResource ModernButton}" Content="JSON" Padding="6,2" FontSize="10" 
                                    ToolTip="Open folder containing iphone_state.json and laptop_state.json" />
                        </StackPanel>
                    </Grid>

                    <!-- Activity Log List -->
                    <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <ListBox x:Name="SidebarLogListBox" ItemsSource="{Binding ProcessLogs}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LogEntry}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="0" Text="{Binding TimestampFormatted}" 
                                                   Foreground="#64748B" FontSize="10" FontFamily="Consolas, monospace" Margin="0,0,4,0" />

                                        <!-- Level Badge -->
                                        <Border Grid.Column="1" Background="#0F172A" BorderBrush="{Binding LevelBrush}" BorderThickness="1" 
                                                CornerRadius="3" Padding="3,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelBadge}" Foreground="{Binding LevelBrush}" 
                                                       FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" />
                                        </Border>

                                        <!-- Message -->
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" 
                                                   Foreground="#E2E8F0" FontSize="10" FontFamily="Consolas, monospace" 
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Metadata JSON Status Info -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="JSON State Files (Unified Schema):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="• iphone_state.json" FontSize="11" Foreground="#38BDF8" Margin="4,2,0,0" />
                        <TextBlock Text="• laptop_state.json" FontSize="11" Foreground="#10B981" Margin="4,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Transfer Engine & Estimations Dashboard -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Transfer Controls & Rate/ETA Metrics -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Primary Action: Backup Only Not Backed Up -->
                        <Button Command="{Binding BackupNotBackedUpCommand}" 
                                Style="{StaticResource SuccessButton}" 
                                IsEnabled="{Binding IsTransferring, Converter={StaticResource InverseBooleanConverter}}"
                                ToolTip="Compare iPhone with laptop JSON, show all pending media in tree, and back up strictly unbacked images &amp; videos (rest are skipped)"
                                Padding="18,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" Foreground="#FDE047" />
                                <TextBlock Text="Backup Only Not Backed Up" FontSize="13" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Secondary Action: Start Backup (Selected) -->
                        <Button Command="{Binding StartBackupCommand}" 
                                Style="{StaticResource PrimaryButton}" 
                                IsEnabled="{Binding IsTransferring, Converter={StaticResource InverseBooleanConverter}}"
                                ToolTip="Start copying all currently checked files in the media tree"
                                Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▶ Start Backup (Selected)" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PauseResumeCommand}" 
                                Style="{StaticResource ModernButton}" 
                                IsEnabled="{Binding IsTransferring}"
                                ToolTip="Temporarily pause or resume active file transfer streams"
                                Padding="14,8" Margin="0,0,10,0">
                            <TextBlock Text="{Binding IsPaused, Converter={x:Null}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⏸ Pause" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="▶ Resume" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Button Command="{Binding CancelBackupCommand}" 
                                Style="{StaticResource DangerButton}" 
                                IsEnabled="{Binding IsTransferring}"
                                ToolTip="Safely stop current backup transfer"
                                Content="⏹ Cancel" Padding="14,8" />
                    </StackPanel>

                    <!-- Real-Time Transfer Metrics (Moving Average Speed & ETA) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Transfer Speed -->
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Transfer Speed: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding ProgressInfo.BytesPerSecond, Converter={StaticResource SpeedConverter}}" 
                                           FontWeight="Bold" Foreground="{StaticResource AccentBlue}" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <!-- Estimated Time Remaining -->
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estimated Time: " Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding ProgressInfo.EstimatedTimeRemaining, Converter={StaticResource TimeRemainingConverter}}" 
                                           FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Dual Progress Bars: Overall & Current File -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Overall Progress Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="{Binding ProgressInfo.StatusMessage, FallbackValue='Ready to transfer'}" 
                                   Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ProgressInfo.CompletedFiles, StringFormat='{}{0} / '}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding ProgressInfo.TotalFiles, StringFormat='{}{0} files ('}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding ProgressInfo.OverallPercentage, StringFormat='{}{0:F1}%)'}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Overall Progress Bar -->
                    <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding ProgressInfo.OverallPercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentBlue}" Height="10" Margin="0,0,0,10" />

                    <!-- Current File Progress Header -->
                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <TextBlock Text="{Binding ProgressInfo.CurrentFileName, StringFormat='Current File: {0}', FallbackValue=''}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" />
                        <TextBlock Text="{Binding ProgressInfo.CurrentFilePercentage, StringFormat='{}{0:F0}%'}" 
                                   HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                    </Grid>

                    <!-- Current File Progress Bar -->
                    <ProgressBar Grid.Row="3" Style="{StaticResource ModernProgressBar}" 
                                 Value="{Binding ProgressInfo.CurrentFilePercentage, Mode=OneWay}" 
                                 Foreground="{StaticResource AccentIndigo}" Height="6" />
                </Grid>
            </Grid>
        </Border>

        <!-- 6. Bottom Notice Bar -->
        <Border Grid.Row="5" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="ℹ️ High-Efficiency Formats: Raw HEIC &amp; MOV files and timestamps are preserved identically. Windows requires HEVC &amp; HEIF Extensions from Microsoft Store for local thumbnail previews." 
                           Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
        </Grid> <!-- End Main Application Layout Grid -->

        <!-- 7. Interactive Live Process Modal Overlay -->
        <Grid Visibility="{Binding IsProcessModalOpen, Converter={StaticResource BoolToVisConverter}}" 
              Background="#D9090D16">
            <Border Width="880" Height="640" CornerRadius="14" 
                    Background="#1E293B" BorderBrush="#475569" BorderThickness="1.5"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Modal Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Active Process Summary Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Real-time Terminal Log Console -->
                        <RowDefinition Height="*" />
                        <!-- Modal Footer Action Buttons -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding ModalTitle}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                                    <TextBlock Text="{Binding ModalSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseProcessModalCommand}" 
                                Style="{StaticResource ModernButton}" Content="✕ Minimize" 
                                ToolTip="Minimize modal back to main view (active operation continues in background)"
                                Padding="14,6" FontSize="12" />
                    </Grid>

                    <!-- Active Operation Status Card -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlue}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ProgressInfo.BytesPerSecond, Converter={StaticResource SpeedConverter}, StringFormat='Speed: {0}'}" 
                                               Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="12" Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding ProgressInfo.EstimatedTimeRemaining, Converter={StaticResource TimeRemainingConverter}, StringFormat='ETA: {0}'}" 
                                               Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Overall Progress Bar -->
                            <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" 
                                         Value="{Binding ProgressInfo.OverallPercentage, Mode=OneWay}" 
                                         Height="8" Foreground="{StaticResource AccentBlue}" />
                        </Grid>
                    </Border>

                    <!-- Real-Time Terminal Log Stream -->
                    <Border Grid.Row="2" Background="#0A0E17" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Terminal Bar -->
                            <Border Grid.Row="0" Background="#161F30" BorderBrush="#253248" BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="8,8,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" />
                                        <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0" />
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,10,0" />
                                        <TextBlock Text="LIVE INTERNAL PROCESS STREAM" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas, monospace" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding ProcessLogs.Count, StringFormat='{}{0} log entries'}" 
                                               FontSize="11" Foreground="#64748B" FontFamily="Consolas, monospace" />
                                </Grid>
                            </Border>

                            <!-- Terminal Log ListBox -->
                            <ListBox x:Name="ModalLogListBox" Grid.Row="1" ItemsSource="{Binding ProcessLogs}" 
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:LogEntry}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="0" Text="{Binding TimestampFormatted}" 
                                                       Foreground="#64748B" FontSize="11" FontFamily="Consolas, monospace" Margin="0,0,8,0" />

                                            <!-- Badge -->
                                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="{Binding LevelBrush}" BorderThickness="1" 
                                                    CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LevelBadge}" Foreground="{Binding LevelBrush}" 
                                                           FontSize="9" FontWeight="Bold" FontFamily="Consolas, monospace" />
                                            </Border>

                                            <!-- Message Text -->
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" 
                                                       Foreground="#F1F5F9" FontSize="11" FontFamily="Consolas, monospace" 
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Modal Action Buttons -->
                    <Grid Grid.Row="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding CopyLogsCommand}" Style="{StaticResource ModernButton}" 
                                    Content="📋 Copy Logs" ToolTip="Copy all internal process logs to clipboard"
                                    Padding="12,6" FontSize="12" Margin="0,0,8,0" />
                            <Button Command="{Binding ClearLogsCommand}" Style="{StaticResource ModernButton}" 
                                    Content="🧹 Clear" ToolTip="Clear internal log display"
                                    Padding="12,6" FontSize="12" Margin="0,0,8,0" />
                            <Button Command="{Binding OpenStateJsonFolderCommand}" Style="{StaticResource ModernButton}" 
                                    Content="📂 Open State JSONs" ToolTip="Open folder containing iphone_state.json and laptop_state.json"
                                    Padding="12,6" FontSize="12" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Cancel Scan button if scanning -->
                            <Button Command="{Binding CancelScanCommand}" Style="{StaticResource DangerButton}" 
                                    Content="⏹ Cancel Scan" ToolTip="Cancel the ongoing iPhone media scan"
                                    Padding="14,6" FontSize="12" Margin="0,0,10,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Cancel Backup button if transferring -->
                            <Button Command="{Binding CancelBackupCommand}" Style="{StaticResource DangerButton}" 
                                    Content="⏹ Cancel Backup" ToolTip="Safely stop current backup transfer"
                                    Padding="14,6" FontSize="12" Margin="0,0,10,0"
                                    Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Minimize / Close button -->
                            <Button Command="{Binding CloseProcessModalCommand}" Style="{StaticResource PrimaryButton}" 
                                    Content="Minimize to Background" ToolTip="Return to main view while current process continues running"
                                    Padding="16,6" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. Apple Photos Lightbox / Modal Viewer -->
        <Grid Visibility="{Binding IsLightboxOpen, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="1100">
            <!-- Dimmed Translucent Backdrop -->
            <Border Background="#F2070D18">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseLightboxCommand}" />
                </Border.InputBindings>
            </Border>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <!-- Lightbox Top Navigation & Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Lightbox Main Stage (Photo / Video Viewer) -->
                    <RowDefinition Height="*" />
                    <!-- Lightbox Bottom Controls / Info Bar -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0" Background="#CC1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Media Title & Details -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedGalleryItem.FileName}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,10,0" />
                                <Border Background="{Binding SelectedGalleryItem.BadgeBg}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedGalleryItem.BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding SelectedGalleryItem.DateFormatted}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="  •  " FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding SelectedGalleryItem.FileSizeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="  •  " FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding SelectedGalleryItem.Folder}" FontSize="11" Foreground="#38BDF8" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Center: Live Photo Play Button (If Live Photo) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"
                                    Visibility="{Binding SelectedGalleryItem.IsLivePhoto, Converter={StaticResource BoolToVisConverter}}">
                            <Button Command="{Binding PlayLivePhotoCommand}" Style="{StaticResource ModernButton}"
                                    Background="#0284C7" BorderBrush="#38BDF8" Padding="14,6"
                                    ToolTip="Play the 3-second companion motion video clip for this Live Photo">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◉ PLAY LIVE PHOTO" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Counter & Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LightboxCounter}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Command="{Binding OpenSelectedInExplorerCommand}" Style="{StaticResource ModernButton}"
                                    Content="📂 Explorer" ToolTip="Reveal this file in Windows File Explorer" Padding="10,6" FontSize="12" Margin="0,0,8,0" />
                            <Button Command="{Binding CloseLightboxCommand}" Style="{StaticResource DangerButton}"
                                    Content="✕ Close" ToolTip="Close preview (or press Esc)" Padding="12,6" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Stage -->
                <Grid Grid.Row="1">
                    <!-- Left Arrow Button -->
                    <Button Command="{Binding PreviousGalleryItemCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="48" Height="64" Margin="8,0,0,0" Panel.ZIndex="10"
                            Style="{StaticResource ModernButton}" Background="#990F172A" BorderBrush="#475569"
                            Content="◀" FontSize="20" FontWeight="Bold" ToolTip="Previous item (Left Arrow)" />

                    <!-- Right Arrow Button -->
                    <Button Command="{Binding NextGalleryItemCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="48" Height="64" Margin="0,0,8,0" Panel.ZIndex="10"
                            Style="{StaticResource ModernButton}" Background="#990F172A" BorderBrush="#475569"
                            Content="▶" FontSize="20" FontWeight="Bold" ToolTip="Next item (Right Arrow)" />

                    <!-- Display Area -->
                    <Border Background="#0A0E17" CornerRadius="10" BorderBrush="#253248" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- 1. Photo Viewer (When NOT playing video) -->
                            <Grid Visibility="{Binding IsLightboxVideo, Converter={StaticResource BoolToVisInverseConverter}}">
                                <Image Source="{Binding LightboxImage}" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Full-Res Loading Spinner -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                                        Background="#CC0F172A" CornerRadius="6" Padding="10,4"
                                        Visibility="{Binding IsLightboxLoadingImage, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏳ Decoding full-res HEIC..." FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 2. Video Player (For Videos & Live Photo Motion Playback) -->
                            <Grid Visibility="{Binding IsLightboxVideo, Converter={StaticResource BoolToVisConverter}}">
                                <MediaElement x:Name="LightboxMediaPlayer"
                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Video Controls Overlay at Bottom of Player -->
                                <Border VerticalAlignment="Bottom" Background="#DD0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Play / Pause -->
                                        <Button x:Name="VideoPlayPauseBtn" Grid.Column="0" Click="VideoPlayPauseBtn_Click"
                                                Style="{StaticResource ModernButton}" Content="▶" Width="36" Height="30" Padding="0" Margin="0,0,10,0" />

                                        <!-- Progress Scrubber -->
                                        <Slider x:Name="VideoScrubberSlider" Grid.Column="1" VerticalAlignment="Center"
                                                Minimum="0" Maximum="1" Value="0"
                                                PreviewMouseDown="VideoScrubberSlider_MouseDown"
                                                PreviewMouseUp="VideoScrubberSlider_MouseUp"
                                                ValueChanged="VideoScrubberSlider_ValueChanged"
                                                Margin="0,0,12,0" />

                                        <!-- Time Indicator -->
                                        <TextBlock x:Name="VideoTimeLabel" Grid.Column="2" Text="00:00 / 00:00"
                                                   FontSize="11" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,14,0" />

                                        <!-- Stop / Loop Button -->
                                        <Button x:Name="VideoLoopBtn" Grid.Column="3" Click="VideoLoopBtn_Click"
                                                Style="{StaticResource ModernButton}" Content="🔁 Loop: On" Padding="8,4" FontSize="11" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Info Bar -->
                <Border Grid.Row="2" Background="#CC1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="{Binding SelectedGalleryItem.FilePath}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Text="Use ◀ / ▶ arrows to navigate • Space to play • Esc to exit" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
